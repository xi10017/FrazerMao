rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to list their own submissions, but only if they filter by their userId.
    // Allow them to get/create/update/delete their own specific submissions.
    match /submissions/{submissionId} {
      allow list: if request.auth != null && request.query.get('where')[0][2] == request.auth.uid;
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Allow reading the leaderboard
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
