/**
 * This ruleset enforces a security model for a leaderboard application.
 *
 * Core Philosophy:
 * This model uses a nested data structure for user-specific data to simplify
 * security rules and ensure users can only access their own information.
 * Publicly readable data (leaderboards, user profiles) is kept in separate
 * top-level collections.
 *
 * Data Structure:
 * 1. /users/{userId}: Stores public user profile information.
 *    - /testCompletions/{completionId}: A subcollection storing private test
 *      completion records for that specific user.
 * 2. /leaderboard_overall: Stores public, aggregated scores for all users.
 * 3. /leaderboard_by_division: Stores public, aggregated scores filtered by division.
 *
 * Key Security Decisions:
 * - Nested Test Completions: By placing `testCompletions` as a subcollection
 *   of `users`, we can create a simple, powerful security rule. A user can
 *   read and write to any document within their own `/users/{userId}` path,
 *   but has no access to anyone else's. This solves the "rules are not filters"
 *   problem for queries, as any query on this subcollection is inherently
 *   scoped to the correct user.
 * - Read-Only Public Leaderboards: All leaderboard collections are publicly
 *   readable. Writes are restricted to the document owner to ensure a user
 *   can only update their own score.
 * - Public User Profiles: User profiles are publicly readable to display names
 *   on leaderboards, but a user can only write to their own profile document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and maintainability.

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the user is accessing their own document.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * @description
     *  Rules for user profiles and their subcollections.
     * @path /users/{userId}
     */
    match /users/{userId} {
      // User profiles are public for leaderboards, but only the owner can write.
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      /**
       * @description
       *   Rules for a user's private `testCompletions` subcollection.
       *   Access is granted only to the owner of the parent user document.
       * @path /users/{userId}/testCompletions/{testCompletionId}
       */
      match /testCompletions/{testCompletionId} {
        allow read, write: if isOwner(userId);
      }

      /**
       * @description
       *   In-progress practice state (answers, timer, flags) for cross-device resume.
       * @path /users/{userId}/inProgress/{testId}
       */
      match /inProgress/{testId} {
        allow read, write: if isOwner(userId);
      }

      /**
       * @description
       *   In-progress retake state, separate from a fresh practice attempt.
       * @path /users/{userId}/retakeInProgress/{testId}
       */
      match /retakeInProgress/{testId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @description
     *   Rules for the overall leaderboard. This collection is public, but users
     *   can only create or update their OWN entry. The document ID must be the user's UID.
     * @path /leaderboard_overall/{userId}
     */
    match /leaderboard_overall/{userId} {
      allow get: if true;
      allow list: if true;
      allow write: if isOwner(userId);
    }

    /**
     * @description
     *  Rules for the division-specific leaderboards. Publicly readable.
     *  A user can only write to a document where the `userId` field matches their own UID.
     * @path /leaderboard_by_division/{leaderboardEntryId}
     */
    match /leaderboard_by_division/{leaderboardEntryId} {
      allow get: if true;
      allow list: if true;
      // Allow create/update if the document's userId belongs to the user making the request
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    /**
     * Anonymous aggregate score statistics (no individual scores).
     */
    match /aggregate_stats/{statsId} {
      allow get: if true;
      allow list: if true;
      allow write: if isSignedIn();
    }

    /**
     * Study groups for private chapter/friend leaderboards.
     */
    match /study_groups/{groupId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow update, delete: if isSignedIn() && request.auth.uid == memberId;
      }
    }

    /**
     * A user's group memberships (for listing joined groups).
     */
    match /users/{userId}/groupMemberships/{groupId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * Admin roster — seed docs via Firebase Console: /admins/{uid}
     */
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * User-submitted answer key correction requests.
     */
    match /answer_key_reports/{reportId} {
      allow get: if isSignedIn() && (
        isAdmin()
        || !exists(/databases/$(database)/documents/answer_key_reports/$(reportId))
        || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Admins approve/reject; users may edit or withdraw pending reports.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending');
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending';
    }

    /**
     * Approved per-test answer key overrides (public read — same as catalog keys).
     */
    match /answer_key_overrides/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
