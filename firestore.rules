rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow users to read their own user document
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Writes to the user document itself are disallowed for now
      allow write: if false;

      // Explicitly allow read and write access to the submissions subcollection
      match /submissions/{submissionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // These collections are not used in the app, but are good to have for future use.
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if false; // Nobody should write directly to tests
    }

    match /solutions/{solutionId} {
      allow read: if isSignedIn();
      allow write: if false; // Nobody should write directly to solutions
    }
  }
}
