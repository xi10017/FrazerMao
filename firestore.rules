rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      // Allow user to read/write their own submissions.
      // The query from the client MUST include `where('userId', '==', request.auth.uid)`
      allow list, get: if request.auth != null && request.query.resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
