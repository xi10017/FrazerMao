rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // This rule allows a user to read and write to their own user document
    // and ANY document in ANY subcollection under that user document.
    // The {document=**} is a recursive wildcard that makes this possible.
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // These collections are not used in the app, but are good to have for future use.
    match /tests/{testId} {
      allow read: if isSignedIn();
    }

    match /solutions/{solutionId} {
      allow read: if isSignedIn();
    }
  }
}
