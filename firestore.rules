rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Users can read their own user document
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Users cannot write to their own user document for now
      allow write: if false;

      // This rule explicitly allows a user to LIST their own submissions
      // and to GET, CREATE, UPDATE, or DELETE a specific submission document.
      match /submissions/{submissionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // These collections are not used in the app, but are good to have for future use.
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if false; // Nobody should write directly to tests
    }

    match /solutions/{solutionId} {
      allow read: if isSignedIn();
      allow write: if false; // Nobody should write directly to solutions
    }
  }
}
