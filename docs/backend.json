{
  "entities": {
    "TestSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TestSubmission",
      "type": "object",
      "description": "Represents a user's score on a particular test.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reference to the User entity. This is the UID of the user."
        },
        "testId": {
          "type": "string",
          "description": "Reference to the Test entity."
        },
        "score": {
          "type": "object",
          "properties": {
            "totalScore": {"type": "number"},
            "correctCount": {"type": "number"},
            "incorrectCount": {"type": "number"},
            "omitCount": {"type": "number"}
          }
        },
         "answers": {
          "type": "object",
          "description": "A map of question numbers to user answers."
        },
        "submittedAt": {
          "type": "string",
          "description": "The timestamp when the test was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "testId",
        "score",
        "answers",
        "submittedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
     "structure": [
      {
        "path": "/submissions/{submissionId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/TestSubmission"
          },
          "description": "Stores all user submissions in a single collection. Security rules ensure users can only access their own submissions."
        }
      }
    ]
  }
}
